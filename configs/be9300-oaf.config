# FanchmWrt-style build for the GL.iNet Flint 3 / GL-BE9300 (IPQ5332).
#
# This is a *seed* config, not a generated full .config. The build script runs
# `make defconfig`, which fills in the board's DEVICE_PACKAGES, the router
# DEFAULT_PACKAGES (dnsmasq, firewall4, nftables, odhcpd, ...) and every
# transitive dependency.
#
# Target is the community `qualcommbe/ipq53xx` port, kernel 6.18. There is no
# public OpenWrt 23.05/QSDK 12.5 tree for this board, so "keep the stock 23.05
# userspace" is not possible while adding an out-of-tree kernel module. See
# docs/STOCK-23.05.md.

CONFIG_TARGET_qualcommbe=y
CONFIG_TARGET_qualcommbe_ipq53xx=y
CONFIG_TARGET_qualcommbe_ipq53xx_DEVICE_glinet_gl-be9300=y

# eMMC board: squashfs rootfs + a TFTP/RAM-boot rescue image.
CONFIG_TARGET_ROOTFS_SQUASHFS=y
CONFIG_TARGET_ROOTFS_INITRAMFS=y

# --- LuCI over HTTPS -------------------------------------------------------
# luci-ssl-openssl -> luci-light -> luci-mod-admin-full, luci-app-firewall,
# luci-proto-ppp, uhttpd + uhttpd-mod-ubus. That is the normal router set.
CONFIG_PACKAGE_luci-ssl-openssl=y
# OAF's Lua controllers use luci.jsonc and nixio directly.
CONFIG_PACKAGE_luci-lib-jsonc=y
CONFIG_PACKAGE_luci-lib-nixio=y
CONFIG_PACKAGE_luci-compat=y

# Simplified Chinese UI. The default language is set to zh-cn by the
# be9300-defaults first-boot script.
CONFIG_PACKAGE_luci-i18n-base-zh-cn=y
CONFIG_PACKAGE_luci-i18n-firewall-zh-cn=y
CONFIG_PACKAGE_luci-i18n-package-manager-zh-cn=y
CONFIG_PACKAGE_luci-i18n-oaf-zh-cn=y

# --- OpenAppFilter ---------------------------------------------------------
# luci-app-oaf pulls appfilter + kmod-oaf + luci-compat at build time. They are
# named explicitly so a missing symbol fails the config check rather than
# producing an image without the DPI engine.
CONFIG_PACKAGE_luci-app-oaf=y
CONFIG_PACKAGE_appfilter=y
CONFIG_PACKAGE_kmod-oaf=y

# --- board defaults --------------------------------------------------------
# Installs /etc/config/fwx with disable_hnat=1 and a first-boot script that
# turns off software/hardware flow offloading. Without this, established flows
# bypass netfilter and OAF cannot classify them.
CONFIG_PACKAGE_be9300-defaults=y

# --- Wi-Fi -----------------------------------------------------------------
# The board profile already selects kmod-ath12k and both firmware blobs.
# OpenSSL is hostapd's reference backend; wpad-basic-mbedtls lacks EAP/DPP.
CONFIG_PACKAGE_wpad-openssl=y
# CONFIG_PACKAGE_wpad-basic-mbedtls is not set

# --- storage, recovery and diagnostics ------------------------------------
CONFIG_PACKAGE_dumpimage=y
CONFIG_PACKAGE_ethtool=y
CONFIG_PACKAGE_kmod-usb-storage=y
CONFIG_PACKAGE_kmod-fs-ext4=y
CONFIG_PACKAGE_kmod-fs-vfat=y
CONFIG_PACKAGE_e2fsprogs=y
CONFIG_PACKAGE_curl=y
CONFIG_PACKAGE_htop=y
CONFIG_PACKAGE_nano-full=y
CONFIG_PACKAGE_tcpdump=y
CONFIG_PACKAGE_iperf3=y
CONFIG_PACKAGE_ip-full=y
# This port has no usable serial console; pstore survives a warm reset and is
# the only way to read a panic after the fact.
CONFIG_PACKAGE_kmod-ramoops=y

# One TLS stack: LuCI is openssl and libcurl is pulled in by appfilter.
CONFIG_LIBCURL_OPENSSL=y

# --- build -----------------------------------------------------------------
CONFIG_CCACHE=y
CONFIG_BUILD_LOG=y
CONFIG_INCLUDE_CONFIG=y
