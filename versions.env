# Pinned inputs. Change these only on purpose, then rebuild and re-test.
#
# Base tree: community mainline port for the GL.iNet Flint 3 / GL-BE9300.
# The tag `ref-20260930` is the release tag with published, hardware-tested
# images (router/ap/vanilla) for this board.
BASE_REPO=https://github.com/perceival/openwrt-flint3.git
BASE_TAG=ref-20260930
BASE_COMMIT=88d31e06f9988266da0467e417cca9c3f4f0f6c7

# OpenAppFilter upstream (OAF 7.0.2). This is the same DPI engine that
# FanchmWrt ships as `fwx`; using upstream keeps the package count small.
OAF_REPO=https://github.com/destan19/OpenAppFilter.git
OAF_COMMIT=0814b87f57181ef238b9a21604c999e98de73cf2
OAF_VERSION=7.0.2
